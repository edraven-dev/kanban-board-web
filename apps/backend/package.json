{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cargo build --release",
    "dev": "cargo run",
    "seed": "cargo run --bin seed",
    "lint": "cargo clippy -- -D warnings",
    "check-types": "cargo check",
    "test": "./scripts/with-cleanup.sh cargo test",
    "test:coverage": "./scripts/with-cleanup.sh cargo llvm-cov --ignore-filename-regex 'src/(main|bin/.*|infrastructure/telemetry)\\.rs' --fail-under-lines 90",
    "migrate:add": "cargo sqlx migrate add",
    "migrate:run": "cargo sqlx migrate run",
    "migrate:revert": "cargo sqlx migrate revert",
    "migrate:info": "cargo sqlx migrate info"
  }
}
